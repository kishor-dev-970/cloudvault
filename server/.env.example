# CloudVault server environment (used by Render)
# Copy/enter these in the Render service's Environment tab.

PORT=4000

# SQLite database file path (relative to /app working dir in the container)
DATABASE_URL="file:./dev.db"

# A long random string for JWT signing
JWT_SECRET=replace-me

# Google OAuth (same client used by the mobile app)
GOOGLE_CLIENT_ID=38612805602-06hq0576g4soitglibb06koqp9te17k3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Server-side API key (used for some calls)
GOOGLE_API_KEY=replace-me

# IMPORTANT: after the service is live, set these redirect URIs to the Render URL
#   https://<your-service>.onrender.com
# And register the SAME URLs as authorized redirect URIs in Google Cloud Console:
GOOGLE_AUTH_REDIRECT_URI="https://<your-service>.onrender.com/api/auth/google/callback"
GOOGLE_REDIRECT_URI="https://<your-service>.onrender.com/api/connect/youtube/callback"

# Deep link back into the mobile app after OAuth (used by the app's login flow)
EXPO_REDIRECT_URL="exp://<your-service>.onrender.com/--/google-callback"

# CORS
CORS_ORIGIN="*"
